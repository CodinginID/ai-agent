# Copy file ini menjadi .env lalu isi nilainya
# cp .env.example .env

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Dapatkan dari https://console.cloud.google.com/apis/credentials
# Create Credentials → OAuth 2.0 Client ID → Web Application
#
# Authorized JavaScript origins : http://localhost:8080
# Authorized redirect URIs      : http://localhost:8080/auth/google/callback
#
# Untuk production ganti dengan domain asli, contoh:
# APP_URL=https://agent.hamasmart.com
# Authorized redirect URIs: https://agent.hamasmart.com/auth/google/callback
APP_URL=http://localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Token dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=ISI_TOKEN_KAMU_DI_SINI

# Proxy HTTP/HTTPS — isi jika koneksi ke api.telegram.org timeout (misal di Indonesia)
# Contoh: HTTPS_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=

# ── AI Provider (cloud LLM, BYOK — otak orchestrator) ───────────────────────
# Pilih provider default + masukkan API key milikmu. Tanpa key, perintah yang
# butuh LLM akan ditolak dengan pesan jelas (perintah regex sepele tetap jalan).
AI_PROVIDER_DEFAULT=anthropic          # anthropic | glm | mock | claude-cli | glm-cli
                                        # mock = dev/testing tanpa key.
                                        # claude-cli/glm-cli = "otak" lokal TANPA API key —
                                        # brain + semua peran dijalankan di worker CLI (Claude
                                        # Code / GLM CLI) yang sudah terpasang di device user.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
GLM_API_KEY=
GLM_API_MODEL=glm-4-plus
GLM_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Aturan tambahan per-peran (opsional): taruh file data/roles/<role>.md
# (engineer/reviewer/research/infra/planner/tester) — isinya ditempel ke
# prompt step peran itu sebagai "Aturan tambahan proyek". Default profil
# peran tetap di app/agents/roles.py.

# Batasi akses Telegram ke user ID tertentu.
# Kosongkan saat development kalau ingin semua chat yang masuk diizinkan.
# Isi beberapa user dengan koma, contoh: ADMIN_USER_IDS=123456789,987654321
ADMIN_USER_IDS=

# Development only: true membuat semua user boleh akses.
# Jangan aktifkan ini di VPS/production.
ALLOW_UNRESTRICTED_ACCESS=false

# Direktori kerja untuk command seperti git status, ls, dan docker.
PROJECT_DIR=.
# Jika jalan via Docker dan ingin agent edit project host:
# HOST_PROJECT_DIR=/home/ali/project/codinginid/ai-agent
# PROJECT_DIR=/workspace

# Timeout command manual dalam detik.
COMMAND_TIMEOUT=20

# Jumlah percakapan terakhir yang dikirim ulang ke Qwen sebagai konteks.
CHAT_HISTORY_LIMIT=6

# Integrasi agent CLI via Telegram.
# Wajib isi ADMIN_USER_IDS sebelum mengaktifkan ini.
ENABLE_CODEX=false
ENABLE_CLAUDE=false
AGENT_WORKDIR=.
# Jika jalan via Docker dan ingin agent edit project host:
# AGENT_WORKDIR=/workspace
AGENT_TIMEOUT=180
AGENT_MAX_PROMPT_CHARS=6000

# Codex CLI
CODEX_BIN=codex
CODEX_MODEL=
CODEX_SANDBOX=read-only
# Full edit mode: CODEX_SANDBOX=danger-full-access

# Claude Code CLI
CLAUDE_BIN=claude
CLAUDE_MODEL=
CLAUDE_PERMISSION_MODE=dontAsk
CLAUDE_ALLOWED_TOOLS=Read,Grep,Glob
CLAUDE_TOOLS=
# Full edit mode:
# CLAUDE_PERMISSION_MODE=bypassPermissions
# CLAUDE_ALLOWED_TOOLS=
# CLAUDE_TOOLS=default

# Multi-role agent registry.
# /agents menampilkan installed/enabled/assigned/ready untuk role ini.
AGENT_ROLE_ENGINEER=codex
AGENT_ROLE_ARCHITECT=glm
AGENT_ROLE_REVIEWER=claude

# GLM CLI placeholder untuk role architect.
# Aktifkan setelah binary/model GLM tersedia di server/container.
ENABLE_GLM=false
GLM_BIN=glm
GLM_MODEL=
GLM_ACCESS_MODE=read-only

# Terminal tools via Telegram.
# Untuk command TUI seperti btop/spf, bot mengirim snapshot/listing karena Telegram tidak punya TTY interaktif.
ENABLE_TERMINAL_TOOLS=false
TERMINAL_WORKDIR=.
# Jika jalan via Docker dan ingin terminal tools membaca project host:
# TERMINAL_WORKDIR=/workspace
TERMINAL_TIMEOUT=20
TERMINAL_ALLOWED_COMMANDS=btop,spf,fastfetch,neofetch,df,free,uptime,whoami,pwd,ls,git,docker,systemctl,journalctl,tail

# ── API Gateway (FastAPI Webhook) ────────────────────────────────────────────
# Default: bot berjalan di mode polling (tidak butuh setting ini).
# Set ENABLE_WEBHOOK=true untuk pakai webhook via FastAPI.
#
# Syarat webhook:
# 1. Server harus punya domain/IP publik dengan HTTPS (Telegram wajib HTTPS).
# 2. WEBHOOK_URL harus full URL tanpa trailing slash, contoh:
#    WEBHOOK_URL=https://bot.example.com
# 3. Arahkan reverse proxy (nginx/caddy) ke port PORT di bawah.
ENABLE_WEBHOOK=false
WEBHOOK_URL=
# Token rahasia untuk memvalidasi request dari Telegram (opsional tapi disarankan).
WEBHOOK_SECRET=
# Port internal uvicorn (juga dipakai Caddy sebagai port eksternal default).
PORT=8080
# Domain publik untuk HTTPS auto-TLS via Caddy (opsional).
# Jika diisi, aktifkan blok HTTPS di Caddyfile dan uncomment port 80/443 di docker-compose.
# Contoh: DOMAIN=bot.example.com
# APP_URL harus diupdate ke https://bot.example.com jika DOMAIN diisi.
DOMAIN=

# ── Control-plane database ───────────────────────────────────────────────────
# Default: SQLite (single-file, zero setup). Cukup untuk single-node, TAPI RAG
# memakai in-memory store (knowledge hilang saat restart).
#
# Untuk RAG persisten + production: aktifkan service Postgres+pgvector bawaan:
#   docker compose --profile postgres up -d
# lalu GANTI dua baris di bawah ke koneksi Postgres berikut (sesuaikan password
# dengan POSTGRES_PASSWORD di bagian "Postgres" lebih bawah):
#   DATABASE_URL=postgresql+psycopg://octopus:octopus@postgres:5432/octopus
#   DATABASE_MIGRATION_URL=postgresql+psycopg://octopus:octopus@postgres:5432/octopus
#
# Alternatif managed (Neon): pakai pooled URL untuk DATABASE_URL, direct URL
# untuk DATABASE_MIGRATION_URL (Alembic tidak boleh lewat PgBouncer txn pooling).
# Jangan commit credential database asli ke repository.
DATABASE_URL=sqlite:///data/control_plane.sqlite3
DATABASE_MIGRATION_URL=sqlite:///data/control_plane.sqlite3

# ── Postgres (hanya dipakai kalau profile `postgres` aktif) ──────────────────
# Kredensial untuk service `postgres` di docker-compose. Ganti password untuk
# production. Harus konsisten dengan DATABASE_URL di atas.
POSTGRES_USER=octopus
POSTGRES_PASSWORD=octopus
POSTGRES_DB=octopus

# ── GitHub (untuk orchestrator /task — PM→Issue→Worker→Close) ─────────────────
# Token dengan scope `repo` (classic) atau `Issues: read/write` (fine-grained).
# Tanpa ini, perintah /task balas 503 (task runner unavailable).
# Repo tujuan tempat issue task dibuat, format: owner/repo.
GITHUB_TOKEN=
GITHUB_REPO=

# ── RAG (Retrieval-Augmented Generation) — memori semantik ───────────────────
# RAG_ENABLED=true → bot recall konteks relevan sebelum kerja & index hasil.
# EMBEDDER_BACKEND: fastembed (lokal CPU, default) | ollama | none (matikan RAG).
# Catatan: RAG persisten butuh Postgres+pgvector (lihat DATABASE_URL).
RAG_ENABLED=true
EMBEDDER_BACKEND=fastembed
RAG_RECALL_K=5

# ── Admin TUI ────────────────────────────────────────────────────────────────
# Token untuk admin HTTP API (/admin/*).
# Kosong = admin API dinonaktifkan (fail-closed, 503). Isi string acak panjang.
# Contoh: openssl rand -hex 32
ADMIN_TOKEN=

# Allowlist email yang boleh registrasi/login (pisahkan koma).
# Kosong = terbuka (siapa pun dgn akun Google). Isi utk membatasi akses.
# Contoh: ALLOWED_EMAILS=ali@hamasmart.com,teammate@example.com
ALLOWED_EMAILS=

# ── Web Push (notifikasi approval / task selesai ke browser) ─────────────────
# Generate pasangan key VAPID (contoh pakai pywebpush yang sudah ada di venv):
#   python -c "from pywebpush import webpush; from py_vapid import Vapid01; \
#     v=Vapid01(); v.generate_keys(); print(v.public_key, v.private_key)"
# Kosong = fitur push nonaktif (NullPush, endpoint /push/* balas 503).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
